doctype html
html(lang="es")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Tipos de cultivo
  body
    include includes/navegacionAbm
    h1 Tipos de cultivo
    a(href="/web/tipos-cultivo/nuevo") Crear tipo de cultivo
    if cultivos.length
      ul
        each cultivo in cultivos
          li
            span #{cultivo._id} — #{cultivo.nombre}
            |  ·
            a(href="/web/tipos-cultivo/" + cultivo._id + "/editar") Editar
            |
            button(type="button" data-eliminar="/tipos-cultivo/" + cultivo._id) Eliminar
    else
      p No hay tipos de cultivo registrados.
