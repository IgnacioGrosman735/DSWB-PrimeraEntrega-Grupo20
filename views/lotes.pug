doctype html
html(lang="es")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Agrotec - Lotes
  body
    h1 Agrotec: lotes agrícolas
    if lotes.length
      ul
        each lote in lotes
          li
            a(href="/web/lotes/" + lote.id) Lote #{lote.id} — #{lote.ubicacion} (#{lote.hectareas} ha)
    else
      p No hay lotes registrados.
    a(href="/lotes") Ver lotes en JSON
