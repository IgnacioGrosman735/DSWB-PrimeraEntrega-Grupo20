# Copiar a .env y completar los valores privados. Se carga automáticamente.
# Las variables ya definidas en la terminal o el hosting tienen prioridad.
MONGODB_URI=mongodb://127.0.0.1:27017/agrotec
# Para Atlas: mongodb+srv://USUARIO:CLAVE_CODIFICADA@HOST/agrotec?authSource=admin
PORT=3100

# Generar un secreto aleatorio de al menos 32 caracteres; nunca subir el real.
SESSION_SECRET=
NODE_ENV=development
# Activar solo detrás de un único proxy de confianza al desplegar con HTTPS.
TRUST_PROXY=0
