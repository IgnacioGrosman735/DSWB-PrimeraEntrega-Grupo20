doctype html
html(lang="es")
    head
        meta(charset="utf-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")
        title Tablero de lotes — AgroTec
        include includes/estilos
    body
        include includes/navegacionAbm
        h1 Tablero de lotes
        - const claseNivel = { "Crítico": "nivel-critico", "Atención": "nivel-atencion", "Sin datos": "nivel-sin-datos", "Normal": "nivel-normal" }
        if lotes.length
            .tabla-contenedor
                table.tabla-abm
                    caption Estado según la última observación cargada, de lo más urgente a lo más estable
                    thead
                        tr
                            th(scope="col") Lote
                            th(scope="col") Estado
                            th(scope="col") Alertas de clima
                            th(scope="col") Prob. Precipitación
                            th(scope="col") Última observación
                            th(scope="col") Estado del cultivo
                            th(scope="col") Ubicación
                            th(scope="col") Hectáreas
                            th(scope="col") Productor
                            th(scope="col") Cultivo
                    tbody
                        each lote in lotes
                            tr
                                td= lote._id
                                td
                                    span.nivel(class=claseNivel[lote.nivelActual])= lote.nivelActual
                                td
                                    if lote.clima && lote.clima.pronostico
                                        each aviso in lote.clima.pronostico.avisos
                                            div
                                                span.nivel.nivel-atencion= aviso
                                td
                                    if lote.clima && lote.clima.pronostico && lote.clima.pronostico.probabilidadPrecipitacion != null
                                        = lote.clima.pronostico.probabilidadPrecipitacion + " %"
                                td= lote.fechaUltima || "—"
                                td= lote.estadoCultivo || "—"
                                td= lote.ubicacion
                                td= lote.hectareas
                                td= lote.productor || "—"
                                td= lote.cultivo || "—"
        else
            p No hay lotes para mostrar.
