doctype html
html(lang="es")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Agrotec - Lote #{lote._id}
  body
    include includes/navegacionAbm
    h1 Lote #{lote._id}
    p Cultivo: #{tipoCultivo.nombre}
    a(href="/web/lotes/" + lote._id + "/editar") Editar
    p Ubicación: #{lote.ubicacion}
    p Hectáreas: #{lote.hectareas}
    a(href="/web/lotes") Volver al listado
