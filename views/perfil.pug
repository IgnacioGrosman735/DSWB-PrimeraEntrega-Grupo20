doctype html
html(lang="es")
    head
        meta(charset="utf-8")
        meta(name="viewport", content="width=device-width, initial-scale=1")
        title Mi perfil — AgroTec
        include includes/estilos
    body
        main#menu-perfil
            h1#bienvenida= nombre !== null ? 'Bienvenido, ' + nombre : 'Bienvenido'
            p#roles-menu Roles: #{roles.join(', ') || 'Sin rol asignado'}
            p(hidden=!(roles.includes('Admin') || roles.includes('Ingeniero') || roles.includes('Cliente')))
                a(href="/web/tablero") Tablero de estado de lotes
            if roles.includes('Admin') || roles.includes('Ingeniero') || roles.includes('Cliente')
                p
                    a(href="/web/asistente") Asistente de AgroTec
            div#opciones-admin(hidden=!roles.includes('Admin'))
                p
                    a(href="/web/lotes") Administrar lotes
                p
                    a(href="/web/tecnicos") Administrar ingenieros
                p
                    a(href="/web/productores") Administrar clientes
                p
                    a(href="/web/tipos-cultivo") Administrar tipos de cultivo
            div#opciones-ingeniero(hidden=!(roles.includes('Ingeniero') && tecnicoId))
                p
                    a#mis-lotes(href=tecnicoId ? '/web/ingenieros/' + tecnicoId + '/lotes' : undefined) Mis lotes y observaciones
                p#aviso-perfil(hidden=roles.includes('Admin') || (roles.includes('Ingeniero') && tecnicoId))= nombre === null ? 'Ingresá desde el login para mostrar tu perfil.' : roles.includes('Ingeniero') ? 'El administrador debe vincular tu cuenta a una ficha técnica para cargar observaciones.' : roles.includes('Cliente') ? 'Consultá el estado de tus lotes en el tablero.' : 'Tu cuenta no tiene un rol asignado. Contactá al administrador.'
            form(action="/auth/logout" method="POST")
                button(type="submit") Cerrar sesión
